# DocuSeal self-host env (ADR-0012). Copy to .env on the Hetzner host.
# .env is gitignored — never commit real secrets.

# openssl rand -hex 64
DOCUSEAL_SECRET_KEY_BASE=

# AWS SES SMTP — SES console ▸ SMTP settings ▸ Create SMTP credentials.
# Host depends on your SES region (Frankfurt shown).
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
