meta {
  name: POST /auth/forgot-password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "you@example.com"
  }
}

docs {
  Always returns 204 — never reveals whether the email matches a user (prevents
  enumeration). If it does match, a single-use token is emailed (Resend, German
  template). Token TTL: 30 minutes.

  Until the web portal / iOS app exist, the recipient pastes the token from the
  email into POST /auth/reset-password below.
}
