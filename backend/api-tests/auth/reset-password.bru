meta {
  name: POST /auth/reset-password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "PASTE_TOKEN_FROM_RESET_EMAIL_HERE",
    "new_password": "your-new-strong-password"
  }
}

docs {
  Redeem a single-use reset token. On success (204):
  - users.password_hash is replaced
  - every active session for that user is revoked (forces re-login on all devices)
  - the token is marked consumed
  - an audit_log row is written (action=user_password_reset)

  Old password and old refresh tokens stop working immediately.
}
