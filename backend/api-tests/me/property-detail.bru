meta {
  name: GET /me/properties/{id}
  type: http
  seq: 3
}

get {
  url: {{base_url}}/me/properties/PASTE_PROPERTY_UUID_HERE
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Property detail with embedded units.

  Scope-checked: returns 404 (not 403) if the user can't see the property —
  avoids leaking existence.
}
