# PRODUCTION .env template. Copy to .env on the prod host and fill in real
# values. NEVER commit the filled file. See infra/docs/prod-cutover.md.
#
# 🔴 = rotate before prod launch (do NOT reuse the value used on staging /
#      exposed during development).
#
# Vars marked "(compose-set)" are injected by docker-compose.prod.yml's
# `environment:` block and override anything here — listed only for clarity.

# --- Application ---
APP_ENV=prod
LOG_LEVEL=INFO

# --- Postgres (strong, prod-only credentials) ---
POSTGRES_USER=whv
POSTGRES_PASSWORD=__SET_STRONG_VALUE__          # 🔴
POSTGRES_DB=whv
# DATABASE_URL + REDIS_URL are compose-set (internal service names).

# --- Auth ---
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# With APP_ENV=prod the backend REFUSES TO BOOT on the default/empty value.
JWT_SECRET=__GENERATE_FRESH__                   # 🔴
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Set here (NOT only in compose) — worker + beat also build Settings with
# APP_ENV=prod, so they must see https origins or the CORS guard blocks boot.
PORTAL_BASE_URL=https://portal.wagner-hausverwaltung.com
ADMIN_BASE_URL=https://admin.wagner-hausverwaltung.com

# --- Impower (PRODUCTION instance) ---
IMPOWER_API_BASE=https://api.app.impower.de/v2
IMPOWER_API_TOKEN=__PROD_TOKEN__                # 🔴
IMPOWER_WEBHOOK_SECRET=__PROD_WEBHOOK_SECRET__  # 🔴 (never empty in prod)

# --- Email: Resend (outbound) ---
RESEND_API_KEY=__PROD_KEY__                     # 🔴
# Set here too so worker-sent notification emails match the backend's sender.
EMAIL_FROM_ADDRESS=support@wagner-hausverwaltung.com
EMAIL_FROM_NAME=Wagner Hausverwaltung Support
EMAIL_INBOUND_ADDRESS=support@wagner-hausverwaltung.com

# --- AWS SES inbound pipeline (S3 + SNS) ---
AWS_ACCESS_KEY_ID=__PROD_IAM_KEY__              # 🔴
AWS_SECRET_ACCESS_KEY=__PROD_IAM_SECRET__       # 🔴
S3_INBOUND_BUCKET=__PROD_INBOUND_BUCKET__
S3_INBOUND_REGION=eu-central-1

# --- AWS SES SMTP (used by the DocuSeal container) ---
SES_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SES_SMTP_USERNAME=__PROD_SES_SMTP_USER__        # 🔴
SES_SMTP_PASSWORD=__PROD_SES_SMTP_PASS__        # 🔴

# --- DocuSeal (e-signature, ADR-0012) ---
# Generate SECRET_KEY_BASE: openssl rand -hex 64
DOCUSEAL_SECRET_KEY_BASE=__GENERATE_FRESH__     # 🔴 (empty => DocuSeal won't boot)
DOCUSEAL_BASE_URL=https://sign.wagner-hausverwaltung.com
DOCUSEAL_API_KEY=__PROD_DOCUSEAL_TOKEN__
DOCUSEAL_WEBHOOK_SECRET=__GENERATE_FRESH__      # 🔴

# --- APNs push (token auth, ADR-0010) ---
APNS_KEY_P8=__PROD_P8_CONTENTS__
APNS_KEY_ID=__10_CHAR_KEY_ID__
APNS_TEAM_ID=K4KDX9GN74
APNS_BUNDLE_ID=com.wagner-hausverwaltung.portal
# false = production APNs gateway (TestFlight + App Store device tokens).
APNS_USE_SANDBOX=false

# --- LLM extraction (ADR-0008) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=__PROD_KEY__                     # 🔴
GEMINI_MODEL=gemini-flash-latest
