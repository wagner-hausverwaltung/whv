# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres credentials ---
# Used by the docker-compose postgres container AND interpolated into DATABASE_URL.
# Local dev defaults — replace with strong values in staging/prod.
POSTGRES_USER=whv
POSTGRES_PASSWORD=__SET_IN_REAL_ENV__
POSTGRES_DB=whv

# --- Backend connection DSNs ---
# Default points at localhost for local dev (running uvicorn outside docker).
# docker-compose overrides hostnames to internal service names for the backend container.
DATABASE_URL=postgresql+asyncpg://whv:__SET_IN_REAL_ENV__@localhost:5432/whv
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=__GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Origin where the admin UI is served — used to build absolute reset links
# in password-reset emails. Override per env (https://admin.wagner-hausverwaltung.com on staging/prod).
ADMIN_UI_BASE_URL=http://localhost:8000

# --- Impower API ---
# Test instance default. Production base: https://api.app.impower.de/v2
# Token request: support+api@impower.de (delivered via Privnote one-time link).
IMPOWER_API_BASE=https://api.prod-replica.develop.impower.de/v2
IMPOWER_API_TOKEN=__SET_IN_REAL_ENV__
# HMAC-SHA256 shared secret for verifying inbound POST /webhooks/impower
# payloads. Impower signs the raw request body with this secret and sends
# the hex digest in the `X-Impower-Signature` header. Backend recomputes
# and compares in constant time before processing. Leave empty in dev to
# disable verification — never deploy to prod without it set. Backend
# already enforces the check (app/api/v1/webhooks.py); only the value
# needs to land in staging/prod .env once Impower provides it.
IMPOWER_WEBHOOK_SECRET=

# --- Email (Resend) ---
# Generate at https://resend.com/api-keys. Domain wagner-hausverwaltung.com
# must be verified in Resend (eu-west-1 region for DSGVO) before sending.
RESEND_API_KEY=__SET_IN_REAL_ENV__
EMAIL_FROM_ADDRESS=noreply@wagner-hausverwaltung.com
EMAIL_FROM_NAME=Wagner Hausverwaltung

# --- LLM (ADR-0008) ---
# Default provider is Gemini (Google AI Studio). Set to "none" to disable
# extraction entirely (Celery tasks short-circuit with a clear audit-log
# entry; no API calls leave the box). Switching to another provider later
# means a new entry in app/integrations/llm/ + flipping this value.
LLM_PROVIDER=gemini
# Generate at https://aistudio.google.com/apikey. Treat as a budget-bearing
# credential — anything that has the key can spend money. AVV with Google
# must be in place before this is set in staging/prod (ADR-0008 §DSGVO).
GEMINI_API_KEY=__SET_IN_REAL_ENV__
# Model selection. gemini-flash-latest is the cost-optimised default
# (~$0.001 per 10-page PDF). Override with gemini-pro-latest for harder
# documents without changing code.
GEMINI_MODEL=gemini-flash-latest

# --- RAG assistant (ADR-0013) ---
# Off by default: the assistant ships dark until the vector store +
# ingestion exist and the ACL cross-user red-team test passes. When true,
# the backend bootstraps the pgvector store on boot and (later) exposes
# /assistant/*. Requires RAG_DATABASE_URL to be set, or the app refuses
# to boot.
RAG_ENABLED=false
# DSN for the SEPARATE pgvector store (the `vectordb` container, started
# via the `rag` compose profile: COMPOSE_PROFILES=rag). NOT the app DB.
# docker-compose sets this for backend/worker automatically; only set it
# here for a non-compose run. The container's own credentials default to
# rag/rag/rag (override via RAG_POSTGRES_USER / _PASSWORD / _DB).
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@vectordb:5432/rag
# Embeddings reuse GEMINI_API_KEY (same Google AVV). gemini-embedding-001 is
# the current model on v1beta (the legacy embedding-001 / text-embedding-004
# were retired and now 404). It emits 3072 dims; the provider requests
# output_dimensionality=768 to match app/rag/constants.EMBEDDING_DIM + the
# pgvector column. A model change re-embeds the whole corpus, so this is
# rarely touched.
RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# --- Fahrtenbuch (ADR-0020) ---
# Kilometergeld for the private car (cents/km, snapshotted per trip) and the
# payee printed on the monthly statement — the car's private owner, who is not
# necessarily the driver. Defaults live in app/config.py; override here if the
# car or the owner changes.
# TRIP_RATE_CENTS_PER_KM=30
# TRIP_PAYEE_NAME=Luis Wagner
# TRIP_PAYEE_ADDRESS=Bozener Straße 12, 71638 Ludwigsburg
# TRIP_REPORT_EMAIL=info@wagner-hausverwaltung.com   # monthly Kilometergeld PDFs (1st, 07:00)

# Public App Store URL of the iOS app — used in the automatic welcome
# announcement for a newly handed-over WEG/MV. Empty until release.
APP_STORE_URL=
