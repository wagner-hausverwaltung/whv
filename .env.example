# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres credentials ---
# Used by the docker-compose postgres container AND interpolated into DATABASE_URL.
POSTGRES_USER=whv
POSTGRES_PASSWORD=whv
POSTGRES_DB=whv

# --- Backend connection DSNs ---
# Default points at localhost for local dev (running uvicorn outside docker).
# docker-compose overrides hostnames to internal service names for the backend container.
DATABASE_URL=postgresql+asyncpg://whv:whv@localhost:5432/whv
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Impower API ---
IMPOWER_API_BASE=https://api.app.impower.de/v2/d
IMPOWER_API_TOKEN=
