# WHV staging reverse proxy. Caddy 2 auto-provisions Let's Encrypt certs.
# Each host's DNS A record must already resolve to this server before
# first start, otherwise the HTTP-01 challenge fails.
#
# Bare-domain hosts (api.*, admin.*, portal.*) are reserved for prod; the
# staging.* prefixed records here keep the bookmarks distinct.

staging.api.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy backend:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Admin host. Serves the same SPA bundle as portal.* but a root visit
# 302-redirects to `/admin` so the URL bar (and therefore React Router
# inside the SPA) actually lands on the admin dashboard. A `rewrite`
# would only change the upstream path — the browser would still see `/`
# and the SPA would render the customer portal home. The Jinja admin
# UI was retired 2026-05-25; the admin SPA lives under /admin/* in the
# same React + MUI bundle the customer portal uses.
staging.admin.wagner-hausverwaltung.com {
    encode gzip zstd

    @root path /
    redir @root /admin 302

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# React SPA for Eigentümer / Mieter / Beirat. Static bundle served by the
# `web` nginx container. The SPA calls staging.api.* cross-origin via JWT
# in localStorage; backend's CORSMiddleware allow_origins this host via
# PORTAL_BASE_URL (and admin.* via ADMIN_BASE_URL).
staging.portal.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
