# WHV staging reverse proxy. Caddy 2 auto-provisions Let's Encrypt certs.
# Each host's DNS A record must already resolve to this server before
# first start, otherwise the HTTP-01 challenge fails.
#
# Bare-domain hosts (api.*, admin.*, portal.*) are reserved for prod; the
# staging.* prefixed records here keep the bookmarks distinct.

staging.api.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy backend:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Admin host. Serves the same SPA bundle as portal.* but a root visit
# 302-redirects to `/admin` so the URL bar (and therefore React Router
# inside the SPA) actually lands on the admin dashboard. A `rewrite`
# would only change the upstream path — the browser would still see `/`
# and the SPA would render the customer portal home. The Jinja admin
# UI was retired 2026-05-25; the admin SPA lives under /admin/* in the
# same React + MUI bundle the customer portal uses.
staging.admin.wagner-hausverwaltung.com {
    encode gzip zstd

    @root path /
    redir @root /admin 302

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# React SPA for Eigentümer / Mieter / Beirat. Static bundle served by the
# `web` nginx container. The SPA calls staging.api.* cross-origin via JWT
# in localStorage; backend's CORSMiddleware allow_origins this host via
# PORTAL_BASE_URL (and admin.* via ADMIN_BASE_URL).
staging.portal.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Self-hosted DocuSeal for e-signatures (ADR-0012). The `docuseal`
# service (docker-compose.staging.yml) signs documents and emails the
# signer via SES; signers use this host directly, never the portal.
sign.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy docuseal:3000 {
        # DocuSeal sends `X-Frame-Options: SAMEORIGIN`, which blocks the WHV
        # admin from embedding its (free, Community-edition) UI in an iframe.
        # Drop it and instead allow framing only from our own origins via a
        # CSP frame-ancestors directive (admin + portal share this site, so
        # DocuSeal's login cookie still works inside the frame). The bare
        # prod hosts are listed too — sign.* is shared (not staging-prefixed),
        # so it serves both environments without a Caddyfile change at cutover.
        header_down -X-Frame-Options
        header_down Content-Security-Policy "frame-ancestors 'self' https://staging.admin.wagner-hausverwaltung.com https://staging.portal.wagner-hausverwaltung.com https://admin.wagner-hausverwaltung.com https://portal.wagner-hausverwaltung.com"
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
