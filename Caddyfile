# WHV staging reverse proxy. Caddy 2 auto-provisions Let's Encrypt certs.
# Domain must already resolve to this server before first start.

staging.api.wagner-hausverwaltung.com {
    encode gzip zstd

    # Forward all paths to the FastAPI backend container.
    reverse_proxy backend:8000

    # Sensible defaults: HSTS, hide server banner.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Admin host. Serves the same SPA bundle as portal.* but rewrites `/` to
# `/admin` so the Verwalter bookmark lands on the admin dashboard. The
# Jinja admin UI was deprecated 2026-05-25; admin is now part of the same
# React SPA mounted at /admin/*.
admin.wagner-hausverwaltung.com {
    encode gzip zstd

    @root path /
    rewrite @root /admin

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Phase 3 (iter 1): React SPA for Eigentümer / Mieter / Beirat. Static bundle
# served by the `web` nginx container. The SPA calls staging.api.* cross-origin
# via the JWT in localStorage; backend's CORSMiddleware allow_origins this host.
portal.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
