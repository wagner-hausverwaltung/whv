# WHV staging reverse proxy. Caddy 2 auto-provisions Let's Encrypt certs.
# Domain must already resolve to this server before first start.

staging.api.wagner-hausverwaltung.com {
    encode gzip zstd

    # Forward all paths to the FastAPI backend container.
    reverse_proxy backend:8000

    # Sensible defaults: HSTS, hide server banner.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Phase 1.6: Jinja2 admin UI. The bookmark `https://admin.wagner-hausverwaltung.com/`
# rewrites to `/admin-ui/` on the backend so users land on the dashboard.
# Today this DNS points at the staging server; when prod ships, the record moves
# to prod and a separate `staging.admin.*` is added for staging.
admin.wagner-hausverwaltung.com {
    encode gzip zstd

    @root path /
    rewrite @root /admin-ui/

    reverse_proxy backend:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# Phase 3 (iter 1): React SPA for Eigentümer / Mieter / Beirat. Static bundle
# served by the `web` nginx container. The SPA calls staging.api.* cross-origin
# via the JWT in localStorage; backend's CORSMiddleware allow_origins this host.
portal.wagner-hausverwaltung.com {
    encode gzip zstd

    reverse_proxy web:80

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
        level INFO
    }
}
