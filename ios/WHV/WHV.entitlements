<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wagner-hausverwaltung.portal</string>
	</array>
	<!-- APNs environment. "development" for Debug / Xcode installs
	     (sandbox gateway), flipped to "production" by Xcode at
	     archive time for TestFlight / App Store builds. The device
	     registers its token with the matching `environment` value so
	     the backend routes to the right APNs host. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- CarPlay "Driving Task" — granted by Apple on 2026-08-23 (Case-ID
	     21774792, see infra/docs/carplay-entitlement-request.md). Drives the
	     CPTemplateApplicationScene in WHV/CarPlay/. The App ID carries the
	     managed capability; automatic signing picks it up. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
